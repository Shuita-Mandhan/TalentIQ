NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Trusted base URL used to construct authentication email destinations. Request
# Origin/Host values are never used for these links.
APP_URL=

# Server-only. Supabase secret (service) key, used solely by the Auth Admin client to send member
# invitations. Never expose it to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only. Which provider answers BOTH requirement extraction (Phase 5) and resume profile
# extraction (Phase 8). Accepted values: "ollama" or "gemini".
#
# There is deliberately no fallback. This names exactly one provider, and if it is unreachable the
# request fails and says so rather than quietly reaching for the other one - because the other one
# may be an external service, and a machine nobody reconfigured must not start sending applicants'
# resumes out of the building on its own.
#
# "ollama" needs no credential and keeps every document on this machine, which is why development
# starts there.
AI_PROVIDER=ollama

# Server-only. Where the local model is served.
OLLAMA_URL=http://127.0.0.1:11434

# Server-only, and required: there is no default. The name must be a model that actually exists in
# your own Ollama installation - check with "ollama list" and pull one if the list is empty.
# qwen3:4b is what this project has been verified against; a reasoning model is fine because the
# provider turns thinking off, which is what makes it fast enough to use.
AI_MODEL=qwen3:4b

# Server-only. How long a single extraction may take, in milliseconds. Optional: omitted, invalid
# or out of the accepted 5s-300s range all fall back to the 120s default.
#
# 120s is enough for requirement extraction from a job description. It is NOT enough for resume
# profile extraction on a local model: measured here with qwen3:4b on CPU, a two-page resume took
# 267s, because the reply is several times longer. Set this to 300000 (the accepted maximum) to
# process resumes with Ollama, or select a hosted provider, which answers in seconds.
AI_TIMEOUT_MS=300000

# ----------------------------------------------------------------------------------------------
# Gemini. Only needed when AI_PROVIDER=gemini.
#
# PRIVACY: with this provider selected, resume text - an applicant's name, contact details and work
# history - is sent to Google. That is a deliberate choice, recorded on every row it produces (each
# processing attempt stores the provider and model that answered it). Leave AI_PROVIDER=ollama if
# documents must stay on this machine.
# ----------------------------------------------------------------------------------------------

# Server-only, and never prefixed NEXT_PUBLIC_. Sent as a request header, never in a URL.
GEMINI_API_KEY=

# Server-only, and required when AI_PROVIDER=gemini: there is no default, for the same reason
# AI_MODEL has none. A model name baked into the application would one day be retired by the vendor
# and the failure would look like an outage rather than a setting.
GEMINI_MODEL=

# Server-only, optional. Override only to point at a different API base; the default is the public
# Generative Language endpoint.
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
